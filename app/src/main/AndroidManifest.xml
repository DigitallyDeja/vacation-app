<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.D424VacationPlanner"
        tools:targetApi="31">
        <activity
            android:name="com.example.d424vacationplanner.UI.ExcursionDetail"
            android:exported="false"
            android:label="Excursion Details"
            android:parentActivityName="com.example.d424vacationplanner.UI.VacationDetail" />

        <receiver
            android:name="com.example.d424vacationplanner.UI.MyReceiver"
            android:enabled="true"
            android:exported="true" />

        <activity
            android:name="com.example.d424vacationplanner.UI.VacationDetail"
            android:exported="false"
            android:label="Vacation Details"
            android:parentActivityName="com.example.d424vacationplanner.UI.VacationList" />
        <activity
            android:name="com.example.d424vacationplanner.UI.VacationList"
            android:exported="false"
            android:label="Vacation List"
            android:parentActivityName="com.example.d424vacationplanner.UI.MainActivity" />
        <activity
            android:name="com.example.d424vacationplanner.UI.MainActivity"
            android:exported="true"
            android:label="Main Activity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>